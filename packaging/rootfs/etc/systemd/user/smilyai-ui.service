[Unit]
Description=SmilyAI independent shell asset server
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/opt/smilyai-os
Environment=PYTHONPATH=/opt/smilyai-os
ExecStart=/usr/bin/python3 -m smilyai.ui_server
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077
